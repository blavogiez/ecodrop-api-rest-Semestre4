meta {
  name: PUT waste-type 404 not found
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/waste-types/9999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": 9999,
    "nom": "inexistant",
    "pointsPerKilo": 1.0
  }
}

tests {
  test("Status 404", function() {
    expect(res.status).to.equal(404);
  });
}
