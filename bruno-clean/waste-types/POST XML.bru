meta {
  name: POST waste-type XML
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/waste-types
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Accept: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <wasteType>
    <id>99</id>
    <nom>test déchets XML</nom>
    <pointsPerKilo>4.0</pointsPerKilo>
  </wasteType>
}

tests {
  test("Status 409", function() {
    expect(res.status).to.equal(409);
  });
}
