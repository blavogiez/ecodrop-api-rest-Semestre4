meta {
  name: PUT waste-type XML
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/waste-types/2
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Accept: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <wasteType>
    <id>2</id>
    <nom>Textile modifié XML</nom>
    <pointsPerKilo>3.5</pointsPerKilo>
  </wasteType>
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
