meta {
  name: PUT collection-point XML
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/points/1
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <collectionPoint>
    <id>1</id>
    <adresse>21 Rue DuChemin modifiée XML</adresse>
    <capaciteMax>500</capaciteMax>
  </collectionPoint>
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
