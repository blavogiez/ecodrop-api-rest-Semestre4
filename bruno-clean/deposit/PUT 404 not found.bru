meta {
  name: PUT deposit 404 not found
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/deposit/999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "id": 999999,
    "userId": 1,
    "pointId": 1,
    "wasteTypeId": 1,
    "poids": 1.0
  }
}

tests {
  test("Status 404", function() {
    expect(res.status).to.equal(404);
  });
}
