meta {
  name: POST deposit XML
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/deposits
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Accept: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <deposit>
    <userId>2</userId>
    <pointId>3</pointId>
    <wasteTypeId>2</wasteTypeId>
    <poids>3.0</poids>
    <datedepot>2025-01-15</datedepot>
    <collecte>false</collecte>
  </deposit>
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });
}
