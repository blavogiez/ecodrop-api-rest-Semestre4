meta {
  name: PUT user XML
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/users/1
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <users>
    <id>1</id>
    <login>paulpaulpaul</login>
    <password>newpasswordxml</password>
    <role>ADMIN</role>
  </users>
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
