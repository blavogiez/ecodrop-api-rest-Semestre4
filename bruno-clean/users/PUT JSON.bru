meta {
  name: PUT user JSON
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/users/1
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "id": 1,
    "login": "paulpaulpaul",
    "password": "newpassword",
    "role": "ADMIN"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
