meta {
  name: PUT user JSON
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/users/4
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "id": 4,
    "login": "temoin",
    "password": "temoin-put-json",
    "role": "USER"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
