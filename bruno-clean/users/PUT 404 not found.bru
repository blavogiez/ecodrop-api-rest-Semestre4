meta {
  name: PUT user 404 not found
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/users/999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "id": 999999,
    "login": "inexistant",
    "password": "inexistant",
    "role": "USER"
  }
}

tests {
  test("Status 404", function() {
    expect(res.status).to.equal(404);
  });
}
