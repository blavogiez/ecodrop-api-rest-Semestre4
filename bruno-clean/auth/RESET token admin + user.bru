meta {
  name: RESET token admin + user
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}
  body: none
  auth: basic
}

auth:basic {
  username: podmanpodman
  password: podmanpodman
}

script:post-response {
  const oldToken = bru.getEnvVar("token");
  const oldTokenAdmin = bru.getEnvVar("tokenAdmin");

  bru.setEnvVar("token", "");
  bru.setEnvVar("tokenAdmin", "");

  res.body = {
    message: "Vos tokens ont été reset",
    token: `"${oldToken}" → ""`,
    tokenAdmin: `"${oldTokenAdmin}" → ""`
  };
}