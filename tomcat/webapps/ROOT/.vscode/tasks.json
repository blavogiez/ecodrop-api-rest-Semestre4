{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compiler le projet",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d",
                "classes",
                "-sourcepath",
                "src",
                "src/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ]
        },
        {
            "label": "Nettoyer",
            "type": "shell",
            "command": "rm",
            "args": [
                "-f",
                "classes/*.class"
            ]
        }
    ]
}