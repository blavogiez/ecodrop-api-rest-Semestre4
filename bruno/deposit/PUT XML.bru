meta {
  name: PUT deposit XML
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/deposits/2
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Accept: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <deposit>
    <id>2</id>
    <userId>2</userId>
    <pointId>1</pointId>
    <wasteTypeId>4</wasteTypeId>
    <poids>4.0</poids>
    <datedepot>2025-01-15</datedepot>
    <collecte>false</collecte>
  </deposit>
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
