meta {
  name: PUT waste-type fake token - 401
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/waste-types/1
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{fakeToken}}
}

body:json {
  {
    "id": 1,
    "nom": "fake update",
    "pointsPerKilo": 1.0
  }
}

tests {
  test("Status 401 - fake token rejeté", function() {
    expect(res.status).to.equal(401);
  });
}
