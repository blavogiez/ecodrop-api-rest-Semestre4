meta {
  name: PUT user XML
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/users/4
  body: xml
  auth: none
}

headers {
  Content-Type: application/xml
  Accept: application/xml
  Authorization: Bearer {{token}}
}

body:xml {
  <users>
    <id>4</id>
    <login>temoin</login>
    <password>temoin-put-xml</password>
    <role>USER</role>
  </users>
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
