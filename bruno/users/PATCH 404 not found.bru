meta {
  name: PATCH user 404 not found
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/users/9999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "login": "inexistant"
  }
}

tests {
  test("Status 404", function() {
    expect(res.status).to.equal(404);
  });
}
